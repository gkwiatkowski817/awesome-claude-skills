<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WA Response Suggester"
            android:textSize="20sp"
            android:textColor="#25D366"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gemini AI odpowiada w Twoim stylu — bezpłatnie"
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <!-- Accessibility -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UPRAWNIENIA"
            android:textSize="11sp"
            android:textColor="#25D366"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usługa dostępności"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_accessibility_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wymagana"
                        android:textColor="#FF5252"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_accessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Włącz"
                    android:textSize="12sp"
                    android:background="#25D366"
                    android:textColor="#FFFFFF"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wyświetlanie nad aplikacjami"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_overlay_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wymagane"
                        android:textColor="#FF5252"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Włącz"
                    android:textSize="12sp"
                    android:background="#25D366"
                    android:textColor="#FFFFFF"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Gemini API Key -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KLUCZ API GEMINI (BEZPŁATNY)"
            android:textSize="11sp"
            android:textColor="#25D366"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/et_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="AIzaSy..."
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:background="#2D2D2D"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pobierz BEZPŁATNY klucz na aistudio.google.com\n(Gemini 1.5 Flash: 1 500 zapytań/dzień za darmo)"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_save_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zapisz klucz API"
                android:background="#25D366"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Status -->
        <LinearLayout
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A2E1A"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skonfiguruj uprawnienia i klucz API"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jak działa:\n1. Otwórz WhatsApp i wejdź w rozmowę\n2. Naciśnij zielony przycisk AI obok pola tekstowego\n3. AI przeanalizuje historię i wygeneruje odpowiedź w Twoim stylu\n4. Sugestia pojawi się w polu — możesz edytować i wysłać"
            android:textColor="#888888"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:paddingBottom="32dp" />

    </LinearLayout>
</ScrollView>
